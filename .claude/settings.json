{
  "outputStyle": "Invariant comments",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-narration-comments.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/fredrik/Projects/private/devstack/plugins/devstack/hooks/cc-check-hook python3 checks/narration.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
